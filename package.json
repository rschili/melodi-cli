{
  "name": "@rschili/melodi-cli",
  "version": "1.8.0",
  "description": "iModel utility",
  "main": "dist/index.mjs",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "test": "vitest",
    "start": "node dist/index.mjs",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' --fix",
    "prebuild": "echo \"export const __BUILD_DATE__ = '$(date -u +%Y-%m-%dT%H:%M:%SZ)';\" > src/buildInfo.ts && npm run lint && npm run typecheck"
  },
  "bin": {
    "melodi": "dist/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rschili/melodi-cli.git"
  },
  "keywords": [
    "itwin",
    "imodel",
    "bentley",
    "ecdb",
    "bim"
  ],
  "author": "Robert Schili",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rschili/melodi-cli/issues"
  },
  "homepage": "https://github.com/rschili/melodi-cli#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "esbuild-node-externals": "^2.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@itwin/core-backend": "^5.14.3",
    "@itwin/core-bentley": "^5.14.3",
    "@itwin/core-common": "^5.14.3",
    "@itwin/ecschema-metadata": "^5.14.3",
    "@itwin/imodels-access-backend": "^6.1.3",
    "@itwin/imodels-access-common": "^6.1.3",
    "@itwin/imodels-client-authoring": "^6.2.2",
    "@itwin/imodels-client-management": "^6.2.2",
    "@itwin/itwins-client": "^3.1.3",
    "@itwin/node-cli-authorization": "^3.1.1",
    "@itwin/object-storage-azure": "^3.1.3",
    "@itwin/object-storage-core": "^3.1.3",
    "@itwin/object-storage-google": "^3.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/semver": "^7.8.0",
    "axios": "^1.20.0",
    "chalk": "^6.0.1",
    "emphasize": "^7.0.0",
    "globby": "^16.2.4",
    "gradient-string": "^3.0.0",
    "module-alias": "^2.3.4",
    "semver": "^7.8.5",
    "simple-update-notifier": "^2.0.0",
    "table": "^6.9.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "inversify": "7.5.2",
    "reflect-metadata": "^0.2.2"
  }
}
